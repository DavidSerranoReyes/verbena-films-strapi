{
  "kind": "collectionType",
  "collectionName": "films",
  "info": {
    "singularName": "film",
    "pluralName": "films",
    "displayName": "Film"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "director": {
      "type": "string",
      "required": true
    },
    "year": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "required": true
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "synopsis_es": {
      "type": "richtext",
      "required": true
    },
    "synopsis_en": {
      "type": "richtext"
    },
    "trailer_url": {
      "type": "string"
    },
    "imdb_url": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "writer": {
      "type": "string"
    },
    "producers": {
      "type": "string"
    },
    "executiveProducer": {
      "type": "string"
    },
    "production": {
      "type": "string"
    },
    "awards": {
      "type": "json"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
